generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  RECRUITER
}
enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}
enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(RECRUITER)
  sessions Session[]
  notes RecruiterNote[]
  history ApplicationStatusHistory[]
  createdAt DateTime @default(now())
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}
model Job {
  id String @id @default(cuid())
  title String
  slug String @unique
  description String
  location String
  salaryMin Int?
  salaryMax Int?
  salaryText String?
  salaryVisible Boolean @default(true)
  jobType String
  experienceRequired String
  skills String[]
  responsibilities String
  requirements String
  benefits String?
  closingDate DateTime
  status JobStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  applications Application[]
  @@index([status, publishedAt])
}
model Candidate {
  id String @id @default(cuid())
  firstName String
  lastName String
  email String @unique
  phone String
  location String
  currentJobTitle String
  yearsExperience Int
  skills String[]
  qualifications String
  linkedinUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  applications Application[]
  documents CandidateDocument[]
  notes RecruiterNote[]
}
model Application {
  id String @id @default(cuid())
  reference String @unique
  candidateId String
  jobId String?
  documentId String?
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job Job? @relation(fields: [jobId], references: [id])
  document CandidateDocument? @relation(fields: [documentId], references: [id])
  status ApplicationStatus @default(NEW)
  consentAt DateTime
  consentVersion String @default("2026-10-v1")
  createdAt DateTime @default(now())
  history ApplicationStatusHistory[]
  notes RecruiterNote[]
  @@unique([candidateId, jobId])
  @@index([status, createdAt])
}
model CandidateDocument {
  id String @id @default(cuid())
  candidateId String
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  cvFileUrl String @unique
  cvOriginalName String
  cvMimeType String
  cvParsed Json?
  extractedName String?
  extractedEmail String?
  extractedPhone String?
  extractedSkills String[] @default([])
  extractedExperience Json?
  extractedEducation Json?
  extractedJobTitles String[] @default([])
  createdAt DateTime @default(now())
  applications Application[]
}
model RecruiterNote {
  id String @id @default(cuid())
  candidateId String
  applicationId String?
  userId String
  body String
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
model ApplicationStatusHistory {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id])
  fromStatus ApplicationStatus
  toStatus ApplicationStatus
  createdAt DateTime @default(now())
}
